                    for _, s in ls:GetChildren() do
                        snap[s.Name] = s.Value
                    end
                end
                return snap
            end
            local before = snapshot()
            for i, style in SELL_STYLES do
                if Flags.Unloading then return end
                log(string.format("Sell test [%d] style=%s", i, style))
